---
import type { CollectionEntry } from 'astro:content';
import { site } from '../../site.config.mjs';
import { topics, withLocale, type Lang } from '../i18n';

interface Props {
  post: CollectionEntry<'posts'> | CollectionEntry<'enPosts'>;
  topicName?: string;
  lang?: Lang;
}
const { post, topicName, lang = 'zh' } = Astro.props;
const { title, description, pubDate, tags, topic } = post.data;
const topicInfo = lang === 'en' ? topics.en[topic] : topics.zh[topic] ?? site.niche.topics.find((t) => t.slug === topic);
const dateStr = pubDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: site.timezone,
});
---

<a class="card" href={withLocale(lang, `/posts/${post.id}/`)}>
  <div class="card__meta">
    <span class="tag tag--brand">{topicName ?? topicInfo?.name ?? topic}</span>
    <time datetime={pubDate.toISOString()}>{dateStr}</time>
  </div>
  <h3 class="card__title">{title}</h3>
  <p class="card__desc">{description}</p>
  {tags.length > 0 && (
    <div class="card__meta">
      {tags.slice(0, 3).map((t) => <span class="tag">#{t}</span>)}
    </div>
  )}
</a>
