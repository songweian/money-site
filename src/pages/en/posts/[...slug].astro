---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('enPosts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'enPosts'>;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);

const all = (await getCollection('enPosts', ({ data }) => !data.draft)).filter((p) => p.id !== post.id);
const sameTopic = all.filter((p) => p.data.topic === post.data.topic).slice(0, 4);
const tagRelated = all
  .filter((p) => p.data.topic !== post.data.topic)
  .filter((p) => (p.data.tags ?? []).some((t) => (post.data.tags ?? []).includes(t)))
  .slice(0, 4 - sameTopic.length);
const related = [...sameTopic, ...tagRelated].map((p) => ({
  title: p.data.title,
  href: `/en/posts/${p.id}/`,
}));
---

<PostLayout lang="en" frontmatter={post.data} headings={headings} slug={post.id} related={related}>
  <Content />
</PostLayout>
