---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { topics } from '../../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('enPosts', ({ data }) => !data.draft);
  return Object.entries(topics.en)
    .map(([slug, topic]) => {
      const list = posts
        .filter((p) => p.data.topic === slug)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
      return { params: { topic: slug }, props: { topic: { slug, ...topic }, posts: list } };
    })
    .filter((entry) => entry.props.posts.length > 0);
}

const { topic, posts } = Astro.props;
const description = `${topic.name}: ${topic.description}. ${posts.length} practical articles with steps, comparisons, and checklists.`;
---

<BaseLayout lang="en" title={topic.name} description={description}>
  <div class="container">
    <Breadcrumb lang="en" items={[{ label: topic.name }]} />
    <section class="section" style="padding-top:22px">
      <h1>{topic.name}</h1>
      <p style="color:var(--c-text-soft);max-width:62ch">{topic.description}</p>
      <AdSlot slot="header" height={90} />
      <div class="grid">
        {posts.map((p) => <PostCard post={p} lang="en" topicName={topic.name} />)}
      </div>
      <AdSlot slot="footer" height={100} />
    </section>
  </div>
</BaseLayout>
