---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../../site.config.mjs';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const index = posts.map((p) => ({
  t: p.data.title,
  d: p.data.description,
  u: `/posts/${p.id}/`,
  k: [p.data.topic, ...(p.data.tags ?? []), p.data.keyword].filter(Boolean).join(' '),
}));
---

<BaseLayout
  title="站内搜索"
  description={`按关键词搜索 ${site.title} 的全部文章，快速找到你需要的 AI 工具评测、自动化教程与效率方法论内容。`}
>

  <div class="container prose">
    <section class="section" style="padding-top:34px">
      <h1>站内搜索</h1>
      <input class="search-input" id="q" type="search" placeholder="输入关键词，如：自动化、提示词、评测" autocomplete="off" />
      <div class="search-results" id="results"></div>
      <p class="empty" id="hint">共 {index.length} 篇文章，输入关键词开始搜索。</p>
    </section>
  </div>

  <script is:inline define:vars={{ index }}>
    const q = document.getElementById('q');
    const box = document.getElementById('results');
    const hint = document.getElementById('hint');
    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    function render(term) {
      const t = term.trim().toLowerCase();
      if (!t) {
        box.innerHTML = '';
        hint.style.display = 'block';
        return;
      }
      hint.style.display = 'none';
      const hits = index
        .map((p) => {
          const hay = (p.t + ' ' + p.d + ' ' + p.k).toLowerCase();
          let score = 0;
          if (p.t.toLowerCase().includes(t)) score += 5;
          if (p.k.toLowerCase().includes(t)) score += 3;
          if (hay.includes(t)) score += 1;
          return { p, score };
        })
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 20);

      box.innerHTML = hits.length
        ? hits
            .map(
              (x) =>
                `<a class="card" href="${x.p.u}"><h3 class="card__title">${esc(x.p.t)}</h3><p class="card__desc">${esc(x.p.d)}</p></a>`
            )
            .join('')
        : '<p class="empty">没有匹配结果，换个关键词试试。</p>';
    }

    q.addEventListener('input', (e) => render(e.target.value));
    if (location.hash) q.value = decodeURIComponent(location.hash.slice(1));
    const params = new URLSearchParams(location.search).get('q');
    if (params) {
      q.value = params;
      render(params);
    }
  </script>
</BaseLayout>
