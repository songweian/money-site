---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AdSlot from '../components/AdSlot.astro';
import { site } from '../../site.config.mjs';
import { topics, ui, withLocale, type Lang } from '../i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    topic: string;
    tags?: string[];
    keyword?: string;
    author?: string;
    heroImage?: string;
    faq?: { q: string; a: string }[];
  };
  headings: Heading[];
  slug: string;
  related: { title: string; href: string }[];
  lang?: Lang;
}
const { frontmatter, headings, slug, related, lang = 'zh' } = Astro.props;
const t = ui[lang];

const topicInfo = lang === 'en' ? topics.en[frontmatter.topic] : topics.zh[frontmatter.topic];
const toc = headings.filter((h) => h.depth === 2);
const postUrl = new URL(withLocale(lang, `/posts/${slug}/`), site.url).toString();
const fmt = (d: Date) =>
  d.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    timeZone: site.timezone,
  });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: frontmatter.title,
  description: frontmatter.description,
  image: frontmatter.heroImage ? new URL(frontmatter.heroImage, site.url).toString() : undefined,
  datePublished: frontmatter.pubDate.toISOString(),
  dateModified: (frontmatter.updatedDate ?? frontmatter.pubDate).toISOString(),
  inLanguage: lang === 'en' ? 'en' : site.lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author: { '@type': 'Organization', name: frontmatter.author ?? site.author.name, url: site.url },
  publisher: {
    '@type': 'Organization',
    name: lang === 'en' ? t.siteTitle : site.title,
    url: site.url,
    logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', site.url).toString() },
  },
  keywords: [frontmatter.keyword, ...(frontmatter.tags ?? [])].filter(Boolean).join(', '),
};

const faqSchema =
  frontmatter.faq && frontmatter.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: frontmatter.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} ogImage={frontmatter.heroImage} lang={lang}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} is:inline />
  {faqSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} is:inline />}

  <div class="container prose">
    <Breadcrumb
      lang={lang}
      items={[
        { href: withLocale(lang, `/topics/${frontmatter.topic}/`), label: topicInfo?.name ?? frontmatter.topic },
        { label: frontmatter.title },
      ]}
    />

    <article class="post-head">
      <h1>{frontmatter.title}</h1>
      <p style="font-size:1.08rem;color:var(--c-text-soft);margin-bottom:16px">
        {frontmatter.description}
      </p>
      <div class="post-meta">
        <span>{frontmatter.author ?? site.author.name}</span>
        <time datetime={frontmatter.pubDate.toISOString()}>{t.publishedOn} {fmt(frontmatter.pubDate)}</time>
        {frontmatter.updatedDate && (
          <time datetime={frontmatter.updatedDate.toISOString()}>{t.updatedOn} {fmt(frontmatter.updatedDate)}</time>
        )}
        {topicInfo && <a href={withLocale(lang, `/topics/${frontmatter.topic}/`)}>{topicInfo.name}</a>}
      </div>

      <AdSlot slot="header" label={t.ad} height={90} />

      {toc.length >= 3 && (
        <nav class="toc" aria-label={t.toc}>
          <p class="toc__title">{t.toc}</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}

      <div class="post-body">
        <slot />
      </div>

      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <p style="margin-top:30px">
          {frontmatter.tags.map((t) => <span class="tag" style="margin-right:6px">#{t}</span>)}
        </p>
      )}

      <AdSlot slot="footer" label={t.ad} height={100} />

      {
        frontmatter.faq && frontmatter.faq.length > 0 && (
          <section class="faq">
            <h2>{t.faq}</h2>
            <dl>
              {frontmatter.faq.map((f) => (
                <>
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </>
              ))}
            </dl>
          </section>
        )
      }
    </article>

    {related.length > 0 && (
      <section class="related">
        <h2>{t.related}</h2>
        <ul style="list-style:none;padding:0">
          {related.map((r) => (
            <li style="margin-bottom:8px">
              <a href={r.href}>{r.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
